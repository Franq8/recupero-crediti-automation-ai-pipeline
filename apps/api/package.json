{
  "name": "@rca/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "smoke": "node scripts/e2e-smoke.mjs",
    "smoke:table": "node scripts/e2e-table.mjs",
    "smoke:discord-v1": "node scripts/e2e-discord-v1.mjs",
    "docgen:listen": "node scripts/doc-generator-discord-listener.mjs",
    "docgen:send-fixtures": "node scripts/send-doc-generator-fixtures.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.15.0",
    "fastify": "^5.3.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "exceljs": "^4.4.0",
    "nanoid": "^5.1.5",
    "pdf-parse": "^1.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}