generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum FileKind {
  PRACTICE_DOCUMENT
  PRACTICE_IMPORT
  TEMPLATE_DOCX
}

enum FieldStatus {
  AUTO_OK
  NEEDS_REVIEW
  MANUAL
  MISSING
}

enum WorkingMode {
  STANDARD_DOCUMENT_SET
  DETERMINISTIC_TABLE_FIRST
}

enum RowStatus {
  READY
  NEEDS_REVIEW
  OUTPUT_GENERATED
}

enum ReviewState {
  TODO
  IN_REVIEW
  APPROVED
}

model Practice {
  id                 String       @id
  caseType           String       @default("precetto_di")
  schemaVer          String       @default("1.0.0")
  selectedTemplateId String?
  workingMode        WorkingMode  @default(STANDARD_DOCUMENT_SET)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  files              StoredFile[]
  fieldValues        FieldValue[]
  tableRows          TableRow[]
  documentSets       DocumentSet[]
  audits             AuditEvent[]
}

model DocumentSet {
  id          String      @id
  practiceId  String
  practice    Practice    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  label       String
  noteText    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  files       StoredFile[]
  tableRows   TableRow[]
}

model StoredFile {
  id            String       @id
  practiceId    String?
  practice      Practice?    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  documentSetId String?
  documentSet   DocumentSet? @relation(fields: [documentSetId], references: [id], onDelete: SetNull)
  kind          FileKind
  filename      String
  mimeType      String
  sizeBytes     Int
  sha256        String
  content       Bytes
  noteText      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Template {
  id          String   @id
  name        String
  version     Int      @default(1)
  filename    String
  mimeType    String
  sizeBytes   Int
  sha256      String
  content     Bytes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name, isActive])
}

model FieldValue {
  id            String      @id
  practiceId    String
  practice      Practice    @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  fieldKey      String
  valueJson     String
  sourceType    String
  sourceRef     String?
  confidence    Float?
  status        FieldStatus @default(MISSING)
  lastModifiedBy String
  lastModifiedAt DateTime   @default(now())

  @@unique([practiceId, fieldKey])
}

model TableRow {
  id           String       @id
  practiceId   String
  practice     Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  rowIndex     Int
  source       String
  originMode   WorkingMode  @default(STANDARD_DOCUMENT_SET)
  sourceSetId  String?
  sourceSet    DocumentSet? @relation(fields: [sourceSetId], references: [id], onDelete: SetNull)
  valuesJson   String
  status       RowStatus    @default(READY)
  reviewState  ReviewState  @default(TODO)
  qualityScore Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([practiceId, rowIndex])
}

model AuditEvent {
  id          String   @id
  practiceId  String
  practice    Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  actor       String
  action      String
  payloadJson String
  createdAt   DateTime @default(now())
}

model DiscordDownloadBatch {
  id                 String   @id
  practiceId         String   @unique
  zipFilename        String
  zipRelativePath    String
  zipSha256          String
  zipSizeBytes       Int
  retainedUntil      DateTime
  tokenHash          String
  tokenExpiresAt     DateTime
  tokenMaxDownloads  Int      @default(3)
  tokenDownloadCount Int      @default(0)
  createdBy          String
  lastDownloadedAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([retainedUntil])
  @@index([tokenHash])
}

model DiscordAutocontinueJob {
  id                         String   @id
  status                     String
  actor                      String
  namingPattern              String?
  openclawRowFlowResultsJson String?
  templateFilename           String
  templateMimeType           String
  templateBytes              Bytes
  tableFilename              String
  tableMimeType              String
  tableBytes                 Bytes
  practiceId                 String?
  finalSummaryJson           String?
  downloadUrl                String?
  downloadExpiresAt          DateTime?
  downloadMaxDownloads       Int?
  downloadRetainedUntil      DateTime?
  errorMessage               String?
  startedAt                  DateTime?
  completedAt                DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([practiceId])
}

