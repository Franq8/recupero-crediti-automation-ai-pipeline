DATABASE_URL=file:./dev.db
PORT=8787
DISCORD_DOWNLOAD_STORAGE_DIR=./tmp/discord-downloads
# PUBLIC_API_BASE_URL=https://automazionerecuperi.lawlabs.cloud/api
# Mac mini preferred PDF renderer:
# WORD_APP_PATH=/Applications/Microsoft Word.app
# PDF_WORD_DISABLE=0
# Optional emergency fallback only (not recommended for final fidelity):
# PDF_ENABLE_LIBREOFFICE_FALLBACK=0
# SOFFICE_BIN=/usr/local/bin/soffice
# Production final-PDF path: keep async jobs on the API host, but offload DOCX->PDF to the Mac mini Word worker.
# On the API host/VPS:
# DOCGEN_PDF_REMOTE_MODE=worker
# DOCGEN_WORKER_SHARED_SECRET=replace-with-long-random-secret
# DOCGEN_PDF_REMOTE_TIMEOUT_MS=600000
# DOCGEN_PDF_REMOTE_POLL_MS=1500
# On the Mac mini worker process:
# DOC_GENERATOR_API_BASE=https://automazionerecuperi.lawlabs.cloud/api
# DOCGEN_WORKER_SHARED_SECRET=replace-with-same-secret
# DOCGEN_PDF_WORKER_ID=mac-mini-word
# DOCGEN_PDF_WORKER_POLL_MS=3000
